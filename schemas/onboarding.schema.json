{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/tssala23/onboarding-claws/schemas/onboarding.schema.json",
  "title": "Onboarding Claw input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "employee_id",
    "role",
    "day_start",
    "timezone",
    "current_focus",
    "key_contacts",
    "communication_style",
    "connectors",
    "claw_output_dir"
  ],
  "properties": {
    "employee_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{2,63}$"
    },
    "role": {
      "enum": [
        "general_management",
        "finance",
        "operations",
        "marketing",
        "technology",
        "engineering"
      ]
    },
    "day_start": {
      "type": "string",
      "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "current_focus": {
      "type": "array",
      "maxItems": 25,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "key_contacts": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["directory_id", "display_name", "email"],
        "properties": {
          "directory_id": { "type": "string", "minLength": 1, "maxLength": 256 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 256 },
          "email": { "type": "string", "format": "email", "maxLength": 254 }
        }
      }
    },
    "communication_style": {
      "enum": ["executive", "concise", "analytical", "conversational"]
    },
    "connectors": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "gmail-mail",
          "google-calendar",
          "outlook-mail",
          "outlook-calendar",
          "slack"
        ]
      }
    },
    "working_days": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "enum": ["sun", "mon", "tue", "wed", "thu", "fri", "sat"] }
    },
    "brief_lead_minutes": { "type": "integer", "minimum": 0, "maximum": 1440 },
    "claw_catalog_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "claw_output_dir": { "type": "string", "pattern": "^/" }
  }
}
